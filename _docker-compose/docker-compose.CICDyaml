version: '3.8'

services:
  # npm 私有制品库
  repo-npm-verdaccio:
    image: verdaccio/verdaccio:latest
    container_name: repo-npm
    ports:
      - "4873:4873"
    volumes:
      - ./.私服/verdaccio/conf:/verdaccio/conf
      - ./.私服/verdaccio/storage:/verdaccio/storage
      - ./.私服/verdaccio/plugins:/verdaccio/plugins
    environment:
      - NODE_ENV=production
    healthcheck:
      test: [ "CMD", "wget", "-q", "--spider", "http://localhost:4873/-/ping" ]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M

  # docker 私有制品库 - 使用完整的Harbor部署
  repo-docker-registry:
    image: registry:2
    container_name: repo-docker-registry
    ports:
      - "5001:5000"
    volumes:
      - ./.私服/registry/data:/var/lib/registry
    environment:
      - REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY=/var/lib/registry
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:5000/v2/" ]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 1G

  # docker tag verdaccio/verdaccio:latest 127.0.0.1:5001/repo-npm
  # docker push 127.0.0.1:5001/repo-npm

  # docker registry UI
  repo-docker-registry-ui:
    image: joxit/docker-registry-ui:latest
    container_name: repo-docker-registry-ui
    ports:
      - "8080:80"
    environment:
      - REGISTRY_URL=http://repo-docker-registry:5000
      - REGISTRY_TITLE=私有Docker仓库
      - SINGLE_REGISTRY=true
    depends_on:
      - repo-docker-registry

    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:80" ]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M

  # git 私有制品库
  repo-gitlab:
    image: gitlab/gitlab-ce:latest
    container_name: repo-gitlab
    ports:
      - "8929:80"
      - "4433:443"
      - "2222:22"
    # environment:
    #   GITLAB_OMNIBUS_CONFIG: |
    #     external_url 'http://localhost:8929'
    #     gitlab_rails['gitlab_shell_ssh_port'] = 2222
    #     # 降低资源使用
    #     postgresql['shared_buffers'] = "256MB"
    #     postgresql['max_connections'] = 50
    #     # 减少Puma进程和线程数
    #     puma['worker_processes'] = 1
    #     puma['max_threads'] = 2
    #     # 减少Sidekiq并发数
    #     sidekiq['concurrency'] = 3
    #     # 禁用不必要的服务
    #     prometheus_monitoring['enable'] = false
    #     # 内存优化
    #     gitlab_rails['env'] = { 'MALLOC_CONF' => 'dirty_decay_ms:1000,muzzy_decay_ms:1000' }
    #     # 时区设置
    #     gitlab_rails['time_zone'] = 'Asia/Shanghai'
    #     # 备份配置
    #     gitlab_rails['backup_keep_time'] = 604800
    # volumes:
    #   - ./.私服/gitlab/config:/etc/gitlab
    #   - ./.私服/gitlab/logs:/var/log/gitlab
    #   - ./.私服/gitlab/data:/var/opt/gitlab

    # shm_size: '512m'
    # healthcheck:
    #   test: [ "CMD", "curl", "-f", "http://localhost/-/health" ]
    #   interval: 60s
    #   timeout: 10s
    #   retries: 3
    #   start_period: 300s
    # deploy:
    #   resources:
    #     limits:
    #       cpus: '2.0'
    #       memory: 8G

  jenkins:
    image: jenkins/jenkins:lts
    container_name: jenkins
    restart: unless-stopped
    user: root # 使用 root 用户以避免权限问题
    ports:
      - "8080:8080" # Jenkins Web界面
      - "50000:50000" # Jenkins代理API端口
    volumes:
      - ./.私服/jenkins_home:/var/jenkins_home # 使用命名卷持久化Jenkins数据
    environment:
      - JENKINS_OPTS=--prefix=/jenkins --httpPort=8080
      - JAVA_OPTS=-Duser.language=zh -Duser.country=CN -Duser.region=CN -Xms512m -Xmx2048m -XX:MaxRAMPercentage=70.0 # 中文语言设置并优化JVM内存
      - JENKINS_JAVA_OPTIONS=-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 # 确保编码正确
      # <useSecurity>true</useSecurity>
      # <arguments>-Duser.language=zh_CN</arguments>
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:8080/jenkins" ]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G

{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit",
    "source.organizeImports": "explicit"
    // "source.fixAll.ts": "explicit",
    // "source.fixAll.json": "explicit",
    // "source.fixAll.markdown": "explicit",
    // "source.fixAll.css": "explicit",
    // "source.fixAll.html": "explicit",
    // "source.fixAll.vue": "explicit",
  },
  "prettier.configPath": "./.mono-prettier.mjs",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "vue"],
  "eslint.format.enable": true,
  "eslint.run": "onSave",
  "baidu.comate.license": "5dbb6e75-78e5-486c-98fa-4a9478a9c290",
  "baidu.comate.username": "wangwei",
  "files.exclude": {
    "**/.DS_Store": false,
    "**/.git": false,
    "**/.hg": false,
    "**/.svn": false,
    "**/Thumbs.db": false
  },
  "stylelint.validate": ["css", "postcss", "scss", "less", "sass", "vue"],
  "stylelint.packageManager": "pnpm",
  "oxc.enable": false,
  "stylelint.configFile": ".mono-stylelint.mjs",
  "stylelint.snippet": ["css", "postcss", "less", "scss", "sass"],
}

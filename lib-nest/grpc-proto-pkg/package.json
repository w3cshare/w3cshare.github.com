{
  "name": "@smarts-isoftstone/grpc-proto-pkg",
  "version": "0.0.7",
  "displayName": "gRPC Proto包",
  "description": "微服务GRPC通信协议包",
  "keywords": [],
  "license": "ISC",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    "lib"
  ],
  "main": "lib/proto-pkg.js",
  "types": "lib/proto-pkg.d.ts",
  "exports": {
    ".": {
      "require": "./lib/proto-pkg.js",
      "types": "./lib/proto-pkg.d.ts"
    },
    "./lib/hero.interface": {
      "types": "./lib/hero.interface.d.ts"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev": "tsc -w",
    "build": "tsc",
    "test": "node ./__tests__/@smarts-isoftstone/grpc-proto-pkg.test.js",
    "lint:json": "eslint --fix \"**/*.json\"",
    "lint:js": "eslint --fix \"**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint --fix \"**/*.{css,scss,less}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,json,md}\""
  },
  "dependencies": {
    "@grpc/proto-loader": "^0.7.13",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "typescript": "^5.7.3"
  },
  "gitHead": "c1a0d49faa5e497641118a5553370a5d441a61f6",
  "devDependencies": {
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-smart": "workspace:^",
    "eslint-plugin-smarts": "workspace:^",
    "prettier": "3.5.3",
    "prettier-plugin-smart": "workspace:^",
    "tsconfig-base-smart": "workspace:^"
  }
}

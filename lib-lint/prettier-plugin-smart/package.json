{
  "name": "prettier-plugin-smart",
  "version": "0.0.4",
  "displayName": "Prettier推荐配置",
  "description": "一个智能的Prettier插件，无需配置，自动应用一致的代码格式化规则",
  "type": "module",
  "keywords": [
    "formatter",
    "javascript",
    "json",
    "prettier",
    "prettier-plugin",
    "react",
    "typescript",
    "vue"
  ],
  "homepage": "https://github.com/w3cshare/w3cshare.github.io#readme",
  "license": "ISC",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    ".prettierrc.js",
    "docs",
    "eslint.config.js",
    "lib",
    "src",
    "tsconfig.json"
  ],
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w3cshare/w3cshare.github.io.git"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev": "rimraf lib && tsup src/**.ts --format=cjs,esm --dts --watch --outDir lib",
    "build": "rimraf lib && tsup src/**.ts --format=cjs,esm --dts --outDir lib",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:json": "eslint --fix \"**/*.json\"",
    "lint:js": "eslint --fix \"**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint --fix \"**/*.{css,scss,less}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,json,md}\""
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "dependencies": {
    "prettier": "^3.5.3",
    "sort-package-json": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.2",
    "@types/prettier": "^3.0.0",
    "eslint": "9.25.1",
    "eslint-plugin-smart": "workspace:^",
    "rimraf": "^6.0.1",
    "tsconfig-base-smart": "workspace:^",
    "tsup": "^8.4.0",
    "typescript": "^5.2.2"
  }
}

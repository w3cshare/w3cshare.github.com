{
  "name": "stylelint-config-smarts",
  "version": "0.0.3",
  "displayName": "Stylelint推荐配置",
  "description": "智能样式代码规范配置，适用于公司内部所有前端项目",
  "type": "module",
  "keywords": [
    "css",
    "less",
    "scss",
    "stylelint",
    "stylelint-config"
  ],
  "homepage": "https://github.com/w3cshare/w3cshare.github.io#readme",
  "license": "ISC",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    ".prettierrc.js",
    "docs",
    "eslint.config.js",
    "lib",
    "src",
    "tsconfig.json"
  ],
  "main": "lib/index.cjs",
  "typings": "lib/index.d.ts",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "repository": {
    "directory": "lib-lint/stylelint-config-smarts",
    "type": "git",
    "url": "https://github.com/w3cshare/w3cshare.github.io.git"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev:ts": "tsc -w",
    "build:ts": "tsc",
    "dev": "rimraf lib && tsup ../stylelint-config-smart/src/index.ts --format=cjs,esm --dts --watch --outDir lib",
    "build": "rimraf lib && tsup ../stylelint-config-smart/src/index.ts --format=cjs,esm --dts --outDir lib",
    "lint:json": "eslint --fix \"**/*.json\"",
    "lint:js": "eslint --fix \"**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint --fix \"**/*.{css,scss,less}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,json,md}\""
  },
  "peerDependencies": {
    "stylelint": ">=15.0.0"
  },
  "dependencies": {
    "stylelint": "^15.11.0",
    "stylelint-bem-newbie": "^0.0.10",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-scss": "^5.2.1"
  },
  "devDependencies": {
    "@types/stylelint": "^14.0.0",
    "eslint": "9.25.1",
    "eslint-plugin-smart": "workspace:^",
    "prettier": "3.5.3",
    "prettier-plugin-smart": "workspace:^",
    "rimraf": "^6.0.1",
    "tsconfig-base-smart": "workspace:^",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}

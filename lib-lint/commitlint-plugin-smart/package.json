{
  "name": "commitlint-plugin-smart",
  "version": "0.0.1",
  "displayName": "包的中文名称",
  "description": "该包的功能描述",
  "type": "module",
  "keywords": [
    "fullstack",
    "lerna",
    "monorepo",
    "nx",
    "pnpm"
  ],
  "homepage": "https://github.com/w3cshare/w3cshare.github.io#readme",
  "bugs": {
    "url": "https://github.com/w3cshare/w3cshare.github.io/issues"
  },
  "license": "ISC",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    "README.md",
    "dist",
    "lib",
    "src",
    "tsconfig.json"
  ],
  "directories": {
    "dist": "dist",
    "docs": "docs",
    "lib": "lib",
    "test": "__tests__"
  },
  "main": "lib/commitlint-plugin-smart.cjs",
  "module": "lib/commitlint-plugin-smart.js",
  "types": "lib/commitlint-plugin-smart.d.ts",
  "exports": {
    ".": {
      "types": "./lib/commitlint-plugin-smart.d.ts",
      "import": "./lib/commitlint-plugin-smart.js",
      "require": "./lib/commitlint-plugin-smart.cjs",
      "default": "./lib/commitlint-plugin-smart.js"
    },
    "./cz-git": {
      "types": "./lib/cz-git/index.d.ts",
      "import": "./lib/cz-git/index.js",
      "require": "./lib/cz-git/index.cjs",
      "default": "./lib/cz-git/index.js"
    }
  },
  "repository": {
    "directory": "lib-lint/commitlint-plugin-smart",
    "type": "git",
    "url": "https://github.com/w3cshare/w3cshare.github.io.git"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev:ts": "tsc -w",
    "build:ts": "tsc",
    "dev": "rimraf lib && tsup --watch",
    "build": "rimraf lib && tsup",
    "lint": "eslint --fix \"**/*.{vue,js,jsx,ts,tsx,json}\"",
    "lint:js": "eslint --fix \"**/*.{js,jsx,ts,tsx}\"",
    "lint:json": "eslint --fix \"**/*.json\"",
    "lint:style": "stylelint --fix \"**/*.{css,scss,less}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,json,md}\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "9.25.1",
    "eslint-plugin-smart": "workspace:^",
    "prettier": "3.5.3",
    "prettier-plugin-smart": "workspace:^",
    "rimraf": "^6.0.1",
    "tsconfig-base-smart": "workspace:^",
    "tsup": "^8.0.0",
    "typescript": "5.3.3"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/lib"
        ]
      }
    }
  }
}

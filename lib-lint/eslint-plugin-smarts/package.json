{
  "name": "eslint-plugin-smarts",
  "version": "0.0.7",
  "displayName": "ESLint插件",
  "description": "内测版-公司通用ESLint规则集，适用于React、Vue、NestJS和TypeScript项目",
  "keywords": [
    "eslint",
    "eslintplugin",
    "nestjs",
    "react",
    "typescript",
    "vue"
  ],
  "license": "ISC",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    "README.md",
    "docs",
    "lib",
    "src"
  ],
  "main": "lib/eslint-plugin-smart.js",
  "module": "lib/eslint-plugin-smart.mjs",
  "types": "lib/eslint-plugin-smart.d.ts",
  "scripts": {
    "start": "pnpm run dev",
    "dev:ts": "tsc -w",
    "build:ts": "tsc",
    "dev": "tsup ../eslint-plugin-smart/src/eslint-plugin-smart.ts --format=cjs,esm --dts --watch --outDir lib",
    "build": "tsup ../eslint-plugin-smart/src/eslint-plugin-smart.ts --format=cjs,esm --dts --outDir lib",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:json": "eslint --fix \"**/*.json\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,json,md}\"",
    "lint:js": "eslint --fix \"**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint --fix \"**/*.{css,scss,less}\""
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "prettier": ">=3.5.3"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsonc": "^2.20.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vue": "^9.21.1",
    "jsonc-eslint-parser": "^2.4.0",
    "typescript": "^5.5.2",
    "vue-eslint-parser": "^9.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "9.25.1",
    "eslint-plugin-smart": "workspace:^",
    "prettier": "3.5.3",
    "prettier-plugin-smart": "workspace:^",
    "tsconfig-base-smart": "workspace:^",
    "tsup": "^8.4.0"
  }
}

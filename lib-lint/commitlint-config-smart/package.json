{
  "name": "commitlint-config-smart",
  "version": "0.0.1",
  "displayName": "Commitlint规范",
  "description": "智能的 commitlint 配置包，基于约定式提交规范，支持中文友好的提交信息提示",
  "type": "module",
  "keywords": [
    "chinese",
    "commit",
    "commitlint",
    "conventional-commits",
    "git",
    "lint",
    "smart"
  ],
  "homepage": "https://github.com/w3cshare/w3cshare.github.io#readme",
  "bugs": {
    "url": "https://github.com/w3cshare/w3cshare.github.io/issues"
  },
  "license": "ISC",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    ".gitignore",
    ".prettierrc.js",
    "docs",
    "eslint.config.js",
    "lib",
    "src",
    "tsconfig.json"
  ],
  "main": "lib/commitlint-plugin-smart.cjs",
  "module": "lib/commitlint-plugin-smart.js",
  "types": "lib/commitlint-plugin-smart.d.ts",
  "exports": {
    ".": {
      "types": "./lib/commitlint-plugin-smart.d.ts",
      "import": "./lib/commitlint-plugin-smart.js",
      "require": "./lib/commitlint-plugin-smart.cjs",
      "default": "./lib/commitlint-plugin-smart.cjs"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "repository": {
    "directory": "lib-lint/commitlint-config-smart",
    "type": "git",
    "url": "https://github.com/w3cshare/w3cshare.github.io.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev:ts": "tsc -w",
    "build:ts": "tsc",
    "dev": "rimraf lib && tsup src/index.ts --format=cjs,esm --dts --watch --outDir lib",
    "build": "rimraf lib && tsup src/index.ts --format=cjs,esm --dts --outDir lib",
    "prepublishOnly": "pnpm run build",
    "lint:json": "eslint --fix \"**/*.json\"",
    "lint:js": "eslint --fix \"**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint --fix \"**/*.{css,scss,less}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,json,md}\""
  },
  "peerDependencies": {
    "@commitlint/cli": ">=17.0.0"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^17.7.0",
    "@commitlint/types": "^17.4.4"
  },
  "devDependencies": {
    "eslint": "9.25.1",
    "eslint-plugin-smart": "workspace:^",
    "prettier": "3.5.3",
    "prettier-plugin-smart": "workspace:^",
    "rimraf": "^6.0.1",
    "tsconfig-base-smart": "workspace:^",
    "tsup": "^8.4.0",
    "typescript": "^5.2.2"
  }
}

{
  "name": "prettier-plugin-smarts",
  "version": "0.0.6",
  "description": "智能格式化插件，适用于公司内部所有前端项目",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.mjs",
  "files": [
    "lib"
  ],
  "scripts": {
    "start": "pnpm run dev",
    "build": "tsup src/**.ts --format=cjs,esm --dts --outDir lib",
    "dev": "tsup src/**.ts --format=cjs,esm --dts --watch --outDir lib",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "prettier",
    "prettier-plugin",
    "formatter",
    "json",
    "typescript",
    "javascript",
    "vue",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "sort-package-json": "^2.6.0",
    "tsup": "^8.4.0"
  },
  "peerDependencies": {
    "prettier": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.2",
    "@types/prettier": "^3.0.0",
    "eslint": "9.25.1",
    "eslint-plugin-smart": "workspace:^",
    "prettier": "^3.5.3",
    "typescript": "^5.2.2"
  },
  "displayName": "Prettier推荐配置（备份）"
}

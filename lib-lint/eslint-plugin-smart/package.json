{
  "name": "eslint-plugin-smart",
  "version": "0.0.20",
  "displayName": "ESLint插件",
  "description": "通用 ESLint 插件&规则集，适用于React、Vue、NestJS和TypeScript项目",
  "type": "module",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslintplugin",
    "lint",
    "nestjs",
    "prettier",
    "react",
    "standard",
    "style",
    "typescript",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/w3cshare/w3cshare.github.io#readme",
  "bugs": {
    "url": "https://github.com/w3cshare/w3cshare.github.io/issues"
  },
  "license": "MIT",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    ".gitignore",
    ".prettierrc.js",
    "LICENSE",
    "README.md",
    "__tests__",
    "dist/*",
    "docs",
    "eslint.config.js",
    "lib/*",
    "src",
    "tsconfig.json"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "directories": {
    "dist": "dist",
    "docs": "docs",
    "lib": "lib",
    "test": "__tests__"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev": "npm run dev:ts",
    "build": "npm run build:ts && npm run build:tsup",
    "dev:ts": "rimraf lib && tsc -w",
    "build:ts": "rimraf lib && tsc",
    "dev:tsup": "rimraf dist && tsup src/index.ts --format=cjs,esm --dts --watch --outDir dist",
    "build:tsup": "rimraf dist && tsup src/index.ts --format=cjs,esm --dts --outDir dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "style:fix": "stylelint --fix \"**/*.{css,scss,less}\"",
    "prepublishOnly": "pnpm run build",
    "release": "standard-version",
    "style": "stylelint \"**/*.{css,scss,less}\""
  },
  "peerDependencies": {
    "@eslint/js": ">=9.0.0",
    "eslint": ">=9.0.0",
    "prettier": ">=3.5.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/css": "^0.8.1",
    "@eslint/js": "^9.28.0",
    "@eslint/json": "^0.12.0",
    "@eslint/markdown": "^6.5.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.0.1",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@vue/eslint-config-typescript": "^14.5.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-jsonc": "^2.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sort": "^4.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vue": "^10.2.0",
    "eslint-plugin-vue-a11y": "^0.0.31",
    "eslint-plugin-vue-pug": "^0.6.2",
    "eslint-plugin-vue-scoped-css": "^2.10.0",
    "globals": "^16.2.0",
    "stylelint": "^15.11.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vue-eslint-parser": "^10.1.3"
  },
  "repository": {
    "directory": "lib-lint/eslint-plugin-smart",
    "type": "git",
    "url": "https://github.com/w3cshare/w3cshare.github.io.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.1",
    "@vue/tsconfig": "^0.7.0",
    "jest": "^30.0.0",
    "rimraf": "^6.0.1",
    "stylelint-config-smart": "workspace:^",
    "ts-jest": "^29.4.0",
    "tsconfig-base-smart": "workspace:^",
    "tsup": "^8.5.0",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

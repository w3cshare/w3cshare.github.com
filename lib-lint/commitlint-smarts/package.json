{
  "name": "commitlint-smarts",
  "version": "0.0.1",
  "displayName": "Commitlint规范",
  "description": "> TODO: description",
  "keywords": [
    "commit",
    "commitlint",
    "conventional-commits",
    "git",
    "lint"
  ],
  "homepage": "https://github.com/w3cshare/w3cshare.github.io#readme",
  "bugs": {
    "url": "https://github.com/w3cshare/w3cshare.github.io/issues"
  },
  "license": "ISC",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    "docs",
    "lib",
    "src"
  ],
  "main": "lib/commitlint-smart.js",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w3cshare/w3cshare.github.io.git"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev": "tsup ../commitlint-smart/src/commitlint-smart.ts --format=cjs,esm --dts --watch --outDir lib",
    "build": "tsup ../commitlint-smart/src/commitlint-smart.ts --format=cjs,esm --dts --outDir lib",
    "lint:json": "eslint --fix \"**/*.json\"",
    "lint:js": "eslint --fix \"**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint --fix \"**/*.{css,scss,less}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,json,md}\""
  },
  "peerDependencies": {
    "@commitlint/cli": ">=17.0.0"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^17.7.0",
    "@commitlint/types": "^17.4.4"
  },
  "devDependencies": {
    "eslint": "9.25.1",
    "prettier": "3.5.3",
    "prettier-plugin-smart": "workspace:^",
    "tsconfig-base-smart": "workspace:^",
    "tsup": "^8.4.0",
    "typescript": "^5.2.2"
  }
}

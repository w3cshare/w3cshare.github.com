{
  "name": "stylelint-config-smart",
  "version": "0.0.3",
  "displayName": "Stylelint推荐配置",
  "description": "智能样式代码规范配置，适用于公司内部所有前端项目",
  "type": "module",
  "keywords": [
    "css",
    "less",
    "scss",
    "stylelint",
    "stylelint-config"
  ],
  "homepage": "https://github.com/w3cshare/w3cshare.github.io#readme",
  "license": "ISC",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    ".prettierrc.js",
    "docs",
    "eslint.config.js",
    "lib",
    "src",
    "tsconfig.json"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "repository": {
    "directory": "lib-lint/stylelint-config-smart",
    "type": "git",
    "url": "https://github.com/w3cshare/w3cshare.github.io.git"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev": "npm run dev:ts",
    "build": "npm run build:ts && npm run build:tsup",
    "dev:ts": "rimraf lib && tsc -w",
    "build:ts": "rimraf lib && tsc",
    "dev:tsup": "rimraf dist && tsup src/index.ts --format=cjs,esm --dts --watch --outDir dist",
    "build:tsup": "rimraf dist && tsup src/index.ts --format=cjs,esm --dts --outDir dist",
    "test:watch": "jest --watch",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "style:fix": "stylelint --fix \"**/*.{css,scss,less}\"",
    "style": "stylelint \"**/*.{css,scss,less}\""
  },
  "peerDependencies": {
    "stylelint": ">=15.0.0"
  },
  "dependencies": {
    "postcss-html": "^1.5.0",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "stylelint-bem-newbie": "^0.0.10",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-less": "^2.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-scss": "^5.2.1"
  },
  "devDependencies": {
    "@types/stylelint": "^14.0.0",
    "eslint": "9.25.1",
    "eslint-plugin-smart": "workspace:^",
    "prettier": "3.5.3",
    "prettier-plugin-smart": "workspace:^",
    "rimraf": "^6.0.1",
    "stylelint": "^15.11.0",
    "tsconfig-base-smart": "workspace:^",
    "tsup": "^8.4.0",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

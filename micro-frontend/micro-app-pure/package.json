    "prettier-plugin-smart": "workspace:^",
    "rimraf": "^6.0.1",
    "tsconfig-base-smart": "workspace:^",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "repository": {
    "directory": "micro-frontend/micro-app-pure",

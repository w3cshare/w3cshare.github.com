{
  "compilerOptions": {
    "outDir": "dist",
    "target": "ES2021",
    "module": "CommonJS",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "baseUrl": ".",
    "strict": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "lib": ["ES2021"],
    "types": ["node", "vscode"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/global.d.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "test", "dist", "lib", "**/*spec.ts"]
}

{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "independent",
  "npmClient": "pnpm",
  "packages": [
    "lib-cli/*",
    "lib-lint/*",
    "lib-mcp/*",
    "lib-nest/*",
    "lib-react/*",
    "lib-vue/*",
    "libs/*",
    "packages/*"
  ],
  "command": {
    "run": {
      "stream": true
    },
    "bootstrap": {
      "hoist": true
    }
  }
}

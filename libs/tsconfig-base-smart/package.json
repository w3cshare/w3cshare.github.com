{
  "name": "tsconfig-base-smart",
  "version": "0.0.2",
  "displayName": "typescript通用配置",
  "description": "typescript通用配置 for tsconfig-base-smart",
  "type": "module",
  "homepage": "https://github.com/w3cshare/w3cshare.github.io#readme",
  "bugs": {
    "url": "https://github.com/w3cshare/w3cshare.github.io/issues"
  },
  "license": "ISC",
  "author": "wangwei <wwdqq7@qq.com>",
  "files": [
    ".gitignore",
    ".prettierrc.js",
    "docs",
    "eslint.config.js",
    "lib",
    "src",
    "tsconfig.base.json",
    "tsconfig.json"
  ],
  "main": "lib/tsconfig-base-smart.js",
  "module": "lib/tsconfig-base-smart.mjs",
  "types": "lib/tsconfig-base-smart.d.ts",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w3cshare/w3cshare.github.io.git"
  },
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc",
    "test": "node ./__tests__/tsconfig-base-smart.test.js",
    "lint:json": "eslint --fix \"**/*.json\" --ignore-pattern .gitignore",
    "lint:js": "eslint --fix \"**/*.{js,jsx,ts,tsx}\" --ignore-pattern .gitignore",
    "lint:style": "stylelint --fix \"**/*.{css,scss,less}\" --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/node": "^22.15.12",
    "eslint": "9.25.1",
    "eslint-plugin-smart": "workspace:^",
    "prettier": "3.5.3",
    "prettier-plugin-smart": "workspace:^",
    "typescript": "5.7.3"
  }
}

{
  "name": "eslint-plugin-smart",
  "version": "1.2.1",
  "description": "公司通用ESLint规则集，适用于React、Vue、NestJS和TypeScript项目",
  "main": "lib/eslint-plugin-smart.js",
  "module": "lib/eslint-plugin-smart.mjs",
  "types": "lib/eslint-plugin-smart.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "start": "pnpm run dev",
    "build": "tsup src/**.ts --format=cjs,esm --dts --outDir lib",
    "dev": "tsup src/**.ts --format=cjs,esm --dts --watch --outDir lib",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "typescript",
    "react",
    "vue",
    "nestjs"
  ],
  "author": "wangwei <wwdqq7@qq.com>",
  "license": "ISC",
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vue": "^9.21.1",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.5.2"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-smarts": "workspace:^"
  }
}

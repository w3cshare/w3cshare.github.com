  "license": "ISC",
  "main": "lib/eslint-plugin-smarts.js",
  "types": "lib/eslint-plugin-smarts.d.ts",
  "module": "lib/eslint-plugin-smarts.mjs",
  "exports": {
    ".": {
      "types": "./lib/eslint-plugin-smarts.d.ts",
      "import": "./lib/eslint-plugin-smarts.mjs",
      "require": "./lib/eslint-plugin-smarts.js"
    }

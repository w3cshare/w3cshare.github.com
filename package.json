{
  "name": "root",
  "private": true,
  "description": "Lerna + NX + PNPM Workspace 的现代化 Monorepo 架构",
  "workspaces": [
    "apps/*",
    "lib-cli/*",
    "lib-lint/*",
    "lib-mcp/*",
    "lib-nest/*",
    "lib-react/*",
    "lib-vue/*",
    "libs/*",
    "micro-frontend/*",
    "micro-service/*",
    "packages/*"
  ],
  "scripts": {
    "// ====== 基础命令 ======": "",
    "install:eslint": "pnpm add eslint@9.25.1 eslint-plugin-smart prettier@3.5.3 -r -D",
    "install:stylelint": "pnpm add stylelint@15.11.0 stylelint-config-smart -w -D",
    "install:commitlint": "pnpm add @commitlint/cli@17.7.0 commitlint-smart -w -D",
    "prepare:husky": "husky install",
    "postinstall.husky": "node -e \"try { require('husky').install() } catch (e) {if (e.code !== 'MODULE_NOT_FOUND') throw e}\"",
    "dev": "npm run docs:dev",
    "preview": "npm run docs:preview",
    "clean": "node ./_scripts/clean.js",
    "structure": "node ./_scripts/structure.js",
    "build": "nx run-many --target=build --all  --parallel",
    "build:pnpm": "pnpm -r run build",
    "test": "nx run-many --target=test --all",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,vue,json,md}\" --ignore-path .gitignore",
    "// ====== Lint 相关命令 ======": "",
    "lint.bak": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --cache",
    "lint": "nx run-many --target=lint --all  --parallel",
    "lint:pnpm": "pnpm -r run lint",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --cache --rule 'no-console: error' --rule 'no-unused-vars: error'",
    "lint:eslint": "pnpm run --filter='eslint-plugin-smarts' dev",
    "// ====== NestJS 服务 ======": "",
    "dev:typeorm": "pnpm run --filter='typeorm-mysql' start:dev",
    "dev:tcp": "pnpm run dev:tcp-main & pnpm run dev:tcp-client",
    "dev:tcp-main": "pnpm run --filter='tcp-main' start:dev",
    "dev:tcp-client": "pnpm run --filter='tcp-client' start:dev",
    "// ====== 内部包开发 ======": "",
    "dev:logger": "pnpm run --filter='@smarts-isoftstone/nestjs-logger' dev",
    "dev:static": "pnpm run --filter='@smarts-isoftstone/nestjs-static' dev",
    "dev:proto": "pnpm run --filter='@smarts-isoftstone/grpc-proto-pkg' dev",
    "dev:config": "pnpm run --filter='@smarts-isoftstone/nestjs-config' dev",
    "// ====== 微前端应用 ======": "",
    "dev:micro-react": "pnpm run --filter='micro-app-react' dev",
    "dev:micro-vue": "pnpm run --filter='micro-app-vue' dev",
    "dev:micro-angular": "pnpm run --filter='micro-app-angular' dev",
    "dev:micro-all": "pnpm run dev:micro-react & pnpm run dev:micro-vue & pnpm run dev:micro-angular",
    "// ====== 微服务应用 ======": "",
    "dev:grpc": "pnpm run dev:grpc-gateway & pnpm run dev:grpc-user",
    "dev:grpc-gateway": "pnpm run --filter='grpc-gateway' start:dev",
    "dev:grpc-user": "pnpm run --filter='grpc-user' start:dev",
    "dev:grpc-test": "pnpm run dev:grpc-main & pnpm run dev:grpc-client",
    "dev:grpc-main": "pnpm run --filter='grpc-main' start:dev",
    "dev:grpc-client": "pnpm run --filter='grpc-client' start:dev",
    "// ====== Lerna 命令 ======": "",
    "new.bak": "lerna create",
    "version.bak": "lerna version",
    "publish.bak": "lerna publish",
    "changed.bak": "lerna changed",
    "list.bak": "lerna list",
    "// ====== NX 命令 ======": "",
    "nx": "nx",
    "nx:graph": "nx graph",
    "nx:affected": "nx affected --target=build",
    "nx:affected:test": "nx affected --target=test",
    "// ====== 辅助命令 ======": "",
    "update-deps": "pnpm update -r --latest",
    "// ====== 文档命令 ======": "",
    "docs:dev": "vitepress dev --port 5173 --host --root-file README.md",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.1",
    "@commitlint/cli": "17.7.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.14.1",
    "commitlint-smart": "workspace:^",
    "cytoscape": "^3.31.2",
    "cytoscape-cose-bilkent": "^4.1.0",
    "eslint": "^9.18.0",
    "eslint-plugin-smart": "workspace:*",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lerna": "^8.2.1",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.6.0",
    "nx": "^20.7.2",
    "prettier": "^3.4.2",
    "stylelint": "15.11.0",
    "stylelint-config-smart": "workspace:^",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "keywords": [
    "monorepo",
    "lerna",
    "nx",
    "pnpm",
    "fullstack"
  ],
  "author": "wangwei wwdqq7@qq.com",
  "license": "ISC",
  "engines": {
    "node": ">=16",
    "pnpm": ">=8"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "debug": "^4.4.0"
  }
}

{
  "name": "root",
  "private": true,
  "description": "Lerna + NX + PNPM Workspace 的现代化 Monorepo 架构",
  "scripts": {
    "// ====== 基础命令 ======": "",
    "start": "npm run dev",
    "dev": "npm run docs:dev",
    "build": "nx run-many --target=build --all  --parallel",
    "preview": "npm run docs:preview",
    "test": "nx run-many --target=test --all",
    "clean": "node ./_scripts/clean.js",
    "structure": "node ./_scripts/structure.js",
    "build:pnpm": "pnpm -r run build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,vue,json,md}\" --ignore-path .gitignore",
    "install:eslint": "pnpm add eslint@9.25.1 eslint-plugin-smart prettier@3.5.3 prettier-plugin-smart tsconfig-base-smart -r -D",
    "install:stylelint": "pnpm add stylelint@15.11.0 stylelint-config-smart -w -D",
    "install:commitlint": "pnpm add @commitlint/cli@17.7.0 commitlint-smart -w -D",
    "prepare:husky": "husky install",
    "postinstall.husky": "node -e \"try { require('husky').install() } catch (e) {if (e.code !== 'MODULE_NOT_FOUND') throw e}\"",
    "// ====== Lint 相关命令 ======": "",
    "lint": "nx run-many --target=lint --all  --parallel",
    "lint:js": "nx run-many --target=lint:js --all  --parallel",
    "lint:json": "nx run-many --target=lint:json --all  --parallel",
    "lint:style": "nx run-many --target=lint:style --all  --parallel",
    "lint:format": "nx run-many --target=format --all  --parallel",
    "// ====== 微前端应用 ======": "",
    "dev:micro": "pnpm run dev:micro-react & pnpm run dev:micro-vue & pnpm run dev:micro-angular",
    "dev:micro-react": "pnpm run --filter='micro-app-react' dev",
    "dev:micro-vue": "pnpm run --filter='micro-app-vue' dev",
    "dev:micro-angular": "pnpm run --filter='micro-app-angular' dev",
    "// ====== 微服务应用 ======": "",
    "dev:grpc": "pnpm run dev:grpc-gateway & pnpm run dev:grpc-user",
    "dev:grpc-gateway": "pnpm run --filter='grpc-gateway' start:dev",
    "dev:grpc-user": "pnpm run --filter='grpc-user' start:dev",
    "// ====== NX 命令 ======": "",
    "nx": "nx",
    "nx:graph": "nx graph",
    "nx:affected": "nx affected --target=build",
    "nx:affected:test": "nx affected --target=test",
    "// ====== 辅助命令 ======": "",
    "update-deps": "pnpm update -r --latest",
    "// ====== 文档命令 ======": "",
    "docs:dev": "vitepress dev --port 5173 --host --root-file README.md",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "lerna": "^8.2.1",
    "nx": "^20.7.2",
    "vitepress": "^1.6.3",
    "vitepress-plugin-smart": "workspace:^",
    "markdown-it-mathjax3": "^4.3.2",
    "commitlint-smart": "workspace:^"
  },
  "peerDependencies": {
    "vitepress-plugin-mermaid": "^2.0.17",
    "@braintree/sanitize-url": "^7.1.1",
    "cytoscape": "^3.31.2",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.13",
    "debug": "^4.4.0"
  },
  "keywords": [
    "monorepo",
    "lerna",
    "nx",
    "pnpm",
    "fullstack"
  ],
  "workspaces": [
    "apps/*",
    "lib-cli/*",
    "lib-lint/*",
    "lib-mcp/*",
    "lib-nest/*",
    "lib-react/*",
    "lib-vue/*",
    "libs/*",
    "micro-frontend/*",
    "micro-service/*",
    "packages/*"
  ],
  "author": "wangwei wwdqq7@qq.com",
  "license": "ISC",
  "engines": {
    "node": ">=16",
    "pnpm": ">=8"
  }
}

{
  "name": "root",
  "private": true,
  "description": "Lerna + NX + PNPM Workspace 的现代化 Monorepo 架构",
  "keywords": [
    "fullstack",
    "lerna",
    "monorepo",
    "nx",
    "pnpm"
  ],
  "license": "ISC",
  "author": "wangwei wwdqq7@qq.com",
  "scripts": {
    "// ====== 基础命令 ======": "",
    "start": "npm run dev",
    "dev": "npm run docs:dev",
    "preview": "npm run docs:preview",
    "build": "nx run-many --target=build --all --parallel --max-parallel=8",
    "build:pnpm": "pnpm -r run build",
    "test": "nx run-many --target=test --all --parallel --max-parallel=8",
    "install:eslint": "pnpm add eslint@9.25.1 eslint-plugin-smart prettier@3.5.3 prettier-plugin-smart tsconfig-base-smart -r -D",
    "install:stylelint": "pnpm add stylelint@15.11.0 stylelint-config-smart -w -D",
    "install:commitlint": "pnpm add @commitlint/cli@17.7.0 conventional-changelog-lint-config-smart -w -D",
    "// ====== Lint 相关命令 ======": "",
    "lint:js": "nx run-many --target=lint:js --all --parallel --max-parallel=8",
    "lint:json": "nx run-many --target=lint:json --all --parallel --max-parallel=8",
    "lint:style": "nx run-many --target=lint:style --all --parallel --max-parallel=8",
    "format:format": "nx run-many --target=format --all --parallel --max-parallel=8",
    "lint:root:json": "eslint --fix \"**/*.json\" --ignore-pattern .mono-ignore --config .mono-eslint.mjs",
    "lint:root:js": "eslint --fix \"**/*.{js,jsx,ts,tsx}\" --ignore-pattern .mono-ignore --config .mono-eslint.mjs",
    "lint:root:style": "stylelint --fix \"**/*.{css,scss,less}\" --ignore-pattern .mono-ignore --config .mono-stylelint.mjs",
    "format:root": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,json,md}\" --ignore-path .mono-ignore --config .mono-prettier.mjs",
    "lint:js:lib-lint": "pnpm run lint:js --projects=lib-lint/*",
    "lint:json:lib-lint": "pnpm run lint:json --projects=lib-lint/*",
    "format:lib-lint": "pnpm run --filter=\"./lib-lint/*\" format",
    "format:lib-lint:nx": "pnpm run format:format --projects=lib-lint/*",
    "// ====== 微前端应用 ======": "",
    "dev:micro": "pnpm run dev:micro-react & pnpm run dev:micro-vue & pnpm run dev:micro-angular",
    "dev:micro-react": "pnpm run --filter='micro-app-react' dev",
    "dev:micro-vue": "pnpm run --filter='micro-app-vue' dev",
    "dev:micro-angular": "pnpm run --filter='micro-app-angular' dev",
    "// ====== 微服务应用 ======": "",
    "dev:grpc": "pnpm run dev:grpc-gateway & pnpm run dev:grpc-user",
    "dev:grpc-gateway": "pnpm run --filter='grpc-gateway' start:dev",
    "dev:grpc-user": "pnpm run --filter='grpc-user' start:dev",
    "// ====== NX 命令 ======": "",
    "nx": "nx",
    "nx:graph": "nx graph",
    "nx:affected": "nx affected --target=build",
    "nx:affected:test": "nx affected --target=test",
    "// ====== 辅助命令 ======": "",
    "update-deps": "pnpm update -r --latest",
    "// ====== 文档命令 ======": "",
    "docs:dev": "vitepress dev --port 5173 --host --root-file README.md",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "commit": "git-cz"
  },
  "peerDependencies": {
    "@braintree/sanitize-url": "^7.1.1",
    "cytoscape": "^3.31.2",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.13",
    "debug": "^4.4.0",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "commitizen": "^4.3.1",
    "conventional-changelog-lint-config-smart": "workspace:^",
    "eslint": "9.25.1",
    "eslint-plugin-smart": "workspace:^",
    "husky": "^7.0.4",
    "lerna": "^8.2.2",
    "markdown-it-mathjax3": "^4.3.2",
    "nx": "^20.7.2",
    "prettier": "3.5.3",
    "prettier-plugin-smart": "workspace:^",
    "stylelint": "^15.11.0",
    "stylelint-config-smart": "workspace:^",
    "vitepress": "^1.6.3",
    "vitepress-plugin-smart": "workspace:^"
  },
  "workspaces": [
    "apps/*",
    "lib-cli/*",
    "lib-lint/*",
    "lib-mcp/*",
    "lib-nest/*",
    "lib-react/*",
    "lib-vue/*",
    "libs/*",
    "micro-frontend/*",
    "micro-service/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=16",
    "pnpm": ">=8"
  }
}

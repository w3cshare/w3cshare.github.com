# 全局环境变量
NODE_ENV=development

# mysql数据库配置
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=test
# 默认关闭，如果需要True可以同步数据库结构
DB_SYNC=false

# 接口版本管理
API_PREFIX=api
API_VERSION=1,2,
